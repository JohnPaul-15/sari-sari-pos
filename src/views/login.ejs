<%- include('partials/head') %>

<style>
    :root {
        --mcd-red: #DA291C;
        --mcd-dark-red: #B71C1C;
        --mcd-yellow: #FFC72C;
        --mcd-dark: #1A1A1A;
        --mcd-gray: #717171;
        --mcd-light-bg: #F4F5F7;
    }

    body {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: var(--mcd-light-bg);
        color: var(--mcd-dark);
        -webkit-font-smoothing: antialiased;
    }

    .login-page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
        box-sizing: border-box;
        position: relative;
        overflow: hidden;
    }

    /* Decorative background blobs for modern flair */
    .login-page::before {
        content: '';
        position: absolute;
        top: -100px;
        right: -100px;
        width: 350px;
        height: 350px;
        background: rgba(255, 199, 44, 0.15);
        border-radius: 50%;
        z-index: 0;
    }

    .login-page::after {
        content: '';
        position: absolute;
        bottom: -100px;
        left: -100px;
        width: 400px;
        height: 400px;
        background: rgba(218, 41, 28, 0.08);
        border-radius: 50%;
        z-index: 0;
    }

    .login-logo {
        text-align: center;
        margin-bottom: 24px;
        z-index: 1;
    }

    .login-logo img {
        width: 72px;
        height: auto;
        display: block;
        margin: 0 auto 12px;
        filter: drop-shadow(0 4px 6px rgba(0,0,0,0.06));
    }

    .login-logo h1 {
        color: var(--mcd-red);
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.5px;
        margin: 0;
    }

    .login-card {
        background: #ffffff;
        width: 100%;
        max-width: 420px;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06), 0 1px 3px rgba(0, 0, 0, 0.04);
        box-sizing: border-box;
        z-index: 1;
        border: 1px solid rgba(0, 0, 0, 0.04);
    }

    .login-card h2 {
        text-align: left;
        color: var(--mcd-dark);
        margin: 0 0 24px;
        font-size: 22px;
        font-weight: 700;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .login-card label {
        display: block;
        margin-bottom: 8px;
        color: var(--mcd-dark);
        font-weight: 600;
        font-size: 14px;
    }

    .login-card input {
        display: block;
        width: 100%;
        padding: 14px 16px;
        background: #FAFAFA;
        border: 1.5px solid #E2E8F0;
        border-radius: 10px;
        font-size: 15px;
        box-sizing: border-box;
        outline: none;
        transition: all 0.2s ease;
        color: var(--mcd-dark);
    }

    .login-card input::placeholder {
        color: #A0AEC0;
    }

    .login-card input:focus {
        background: #ffffff;
        border-color: var(--mcd-red);
        box-shadow: 0 0 0 4px rgba(218, 41, 28, 0.12);
    }

    .btn-block {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 10px;
        background: var(--mcd-red);
        color: white;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        margin-top: 8px;
        transition: background 0.2s ease, transform 0.1s ease;
        box-shadow: 0 4px 12px rgba(218, 41, 28, 0.3);
    }

    .btn-block:hover {
        background: var(--mcd-dark-red);
    }

    .btn-block:active {
        transform: scale(0.98);
    }

    .register-link {
        text-align: center;
        margin-top: 24px;
        color: var(--mcd-gray);
        font-size: 14px;
        margin-bottom: 0;
    }

    .register-link a {
        color: var(--mcd-red);
        font-weight: 700;
        text-decoration: none;
        margin-left: 4px;
    }

    .register-link a:hover {
        text-decoration: underline;
    }

    .bottom-design {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 12px;
        background: var(--mcd-yellow);
        border-top: 4px solid var(--mcd-red);
        z-index: 10;
    }

    .alert-error {
        background: #FFF5F5;
        border: 1px solid #FEB2B2;
        color: var(--mcd-dark-red);
        padding: 12px 16px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    @media (max-width: 480px) {
        .login-card {
            padding: 24px 20px;
            border-radius: 16px;
            box-shadow: none;
            border: none;
            background: transparent;
        }
        
        .login-page {
            justify-content: flex-start;
            padding-top: 20px;
        }
    }
</style>

<div class="login-page">

    <!-- McDonald's Logo and Name -->
    <div class="login-logo">
        <img
            src="https://upload.wikimedia.org/wikipedia/commons/4/4b/McDonald%27s_golden_arch.svg"
            alt="McDonald's Golden Arches Logo"
        >
        <h1>McDonald's POS</h1>
    </div>

    <!-- Login Form -->
    <form method="POST" action="/login" class="login-card">

        <h2>Sign in to continue</h2>

        <% if (typeof flash !== 'undefined' && flash.error) { %>
            <div class="alert-error">
                <span>⚠️</span> <%= flash.error %>
            </div>
        <% } %>

        <div class="form-group">
            <label for="username">Username</label>
            <input
                type="text"
                id="username"
                name="username"
                placeholder="Enter your username"
                autocomplete="username"
                autofocus
                required
            >
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input
                type="password"
                id="password"
                name="password"
                placeholder="Enter your password"
                autocomplete="current-password"
                required
            >
        </div>

        <button type="submit" class="btn-block">
            Sign In
        </button>

        <p class="register-link">
            No account yet?
            <a href="/register">Register</a>
        </p>

    </form>

    <!-- Brand Accent Footer Bar -->
    <div class="bottom-design"></div>

</div>

<%- include('partials/foot') %>