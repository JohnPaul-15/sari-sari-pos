<%- include('partials/head') %>

<style>
    body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        background: #f5f5f5;
    }

    .login-page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 30px 20px 80px;
        box-sizing: border-box;
        position: relative;
        overflow: hidden;
    }

    .login-logo {
        text-align: center;
        margin-bottom: 25px;
    }

    .login-logo img {
        width: 100px;
        height: auto;
        display: block;
        margin: 0 auto 10px;
    }

    .login-logo h1 {
        color: #da291c;
        font-size: 32px;
        font-weight: bold;
        margin: 0;
    }

    .login-card {
        background: white;
        width: 100%;
        max-width: 450px;
        padding: 35px;
        border-radius: 12px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.10);
        box-sizing: border-box;
        z-index: 1;
    }

    .login-card h2 {
        text-align: center;
        color: #da291c;
        margin: 0 0 25px;
        font-size: 26px;
    }

    .login-card label {
        display: block;
        margin-bottom: 18px;
        color: #333;
        font-weight: bold;
    }

    .login-card input {
        display: block;
        width: 100%;
        padding: 13px;
        margin-top: 8px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 16px;
        box-sizing: border-box;
        outline: none;
    }

    .login-card input:focus {
        border-color: #da291c;
        box-shadow: 0 0 4px rgba(218, 41, 28, 0.25);
    }

    .btn-block {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 7px;
        background: #da291c;
        color: white;
        font-size: 17px;
        font-weight: bold;
        cursor: pointer;
        margin-top: 5px;
    }

    .btn-block:hover {
        background: #b71c1c;
    }

    .register-link {
        text-align: center;
        margin-top: 25px;
        color: #444;
    }

    .register-link a {
        color: #da291c;
        font-weight: bold;
        margin-left: 8px;
    }

    .bottom-design {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 55px;
        background: #da291c;
        border-top: 8px solid #ffc72c;
    }

    .alert-error {
        background: #ffe5e5;
        color: #b71c1c;
        padding: 10px;
        border-radius: 5px;
        margin-bottom: 15px;
    }

    @media (max-width: 500px) {
        .login-card {
            padding: 25px 20px;
        }

        .login-logo h1 {
            font-size: 27px;
        }
    }
</style>

<div class="login-page">

    <!-- McDonald's Logo and Name -->
    <div class="login-logo">
        <img
            src="https://upload.wikimedia.org/wikipedia/commons/4/4b/McDonald%27s_golden_arch.svg"
            alt="McDonald's Golden Arches Logo"
        >

        <h1>McDonald's POS</h1>
    </div>

    <!-- Login Form -->
    <form method="POST" action="/login" class="login-card">

        <h2>Sign in to continue</h2>

        <% if (typeof flash !== 'undefined' && flash.error) { %>
            <div class="alert-error">
                <%= flash.error %>
            </div>
        <% } %>

        <label>
            Username
            <input
                type="text"
                name="username"
                placeholder="Enter your username"
                autocomplete="username"
                autofocus
                required
            >
        </label>

        <label>
            Password
            <input
                type="password"
                name="password"
                placeholder="Enter your password"
                autocomplete="current-password"
                required
            >
        </label>

        <button type="submit" class="btn-block">
            Login
        </button>

        <p class="register-link">
            No account yet?
            <a href="/register">Register</a>
        </p>

    </form>

    <!-- Red and Yellow Footer Design -->
    <div class="bottom-design"></div>

</div>

<%- include('partials/foot') %>
